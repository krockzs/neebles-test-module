{
  "schema": 3,
  "name": "test-module",
  "version": "1.1.0",
  "entrypoint": "test-module.sh",
  "settings": "settings/default.json",
  "contracts": [
    {
      "type": "commands",
      "file": "contracts/commands.json",
      "schema": 1,
      "enabled": true
    }
  ],
  "dependencies": {
    "system": [
      {
        "name": "python3",
        "install": {
          "installer": "apt",
          "operation": "install",
          "variables": {
            "packages": [
              "python3"
            ]
          }
        },
        "verify": {
          "installer": "dpkg-query",
          "operation": "check_installed",
          "variables": {
            "package": "python3"
          }
        },
        "required": true
      },
      {
        "name": "python3-tk",
        "install": {
          "installer": "apt",
          "operation": "install",
          "variables": {
            "packages": [
              "python3-tk"
            ]
          }
        },
        "verify": {
          "installer": "dpkg-query",
          "operation": "check_installed",
          "variables": {
            "package": "python3-tk"
          }
        },
        "required": true
      }
    ],
    "modules": []
  },
  "commands": {
    "default": {
      "requires_root": false,
      "lifecycle": "oneshot",
      "launcher": false
    },
    "open": {
      "requires_root": false,
      "lifecycle": "tracked",
      "launcher": true
    }
  },
  "tray": {
    "protocol": 1,
    "icon": "icon.jpeg",
    "provider": "test-module.sh"
  },
  "notifications": {
    "protocol": 1
  }
}
